{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nkkko/ai-sandbox-benchmark/schemas/benchmark_run.schema.json",
  "title": "Benchmark run record",
  "description": "Canonical record for one benchmark run. Each record is self-contained: metadata about the run plus per-test, per-run, per-provider timing statistics. Every record stored in the history file validates against this schema.",
  "type": "object",
  "required": ["schema_version", "id", "timestamp", "providers", "tests", "metadata", "results"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for this run (UUID)."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 timestamp of the run."
    },
    "providers": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Stable identifier from the test's TEST_META declaration."
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["warmup_runs", "measurement_runs", "target_region"],
      "properties": {
        "total_duration": { "type": "number" },
        "warmup_runs": { "type": "integer", "minimum": 0 },
        "measurement_runs": { "type": "integer", "minimum": 1 },
        "target_region": { "type": "string" },
        "command_line_args": { "type": "object" }
      }
    },
    "results": {
      "type": "object",
      "description": "Keyed by test key, then run key, then provider name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["total_time", "stats"],
            "properties": {
              "total_time": { "type": "number", "minimum": 0 },
              "stats": {
                "type": "object",
                "description": "Keyed by metric name. Empty when the run failed before any measurement.",
                "additionalProperties": {
                  "type": "object",
                  "required": ["mean", "median", "p95", "p99", "samples"],
                  "properties": {
                    "mean": { "type": "number" },
                    "std": { "type": "number" },
                    "min": { "type": "number" },
                    "max": { "type": "number" },
                    "median": { "type": "number" },
                    "p95": { "type": "number" },
                    "p99": { "type": "number" },
                    "samples": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              "error": { "type": ["string", "null"] },
              "probe_errors": {
                "type": "integer",
                "minimum": 0,
                "description": "Burst mode only: number of probes that failed out of burst_size."
              }
            }
          }
        }
      }
    }
  }
}
